}

/**
 * Implements hook_install().
 */
function ut_gc_setup_install($is_syncing) {
  // In una sincronizzazione di configurazione i link (contenuto) arrivano
  // con il database, non vanno ricreati.
  if ($is_syncing) {
    return;
  }

  // Il link "Home" del profilo standard non fa parte della grafica coordinata.
  $menu_link_manager = \Drupal::service('plugin.manager.menu.link');
  if ($menu_link_manager->hasDefinition('standard.front_page')) {
    $menu_link_manager->updateDefinition('standard.front_page', ['enabled' => FALSE]);
  }

  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  foreach (_ut_gc_setup_default_links() as $menu_name => $links) {
    // Non tocca un menu che ha già dei link (es. il main di un sito esistente).
    if ($storage->getQuery()->accessCheck(FALSE)->condition('menu_name', $menu_name)->count()->execute()) {
      continue;
    }
    foreach ($links as $weight => $link) {
      [$title, $uri, $attributes] = $link + [2 => []];
      MenuLinkContent::create([
        'title' => $title,
        'link' => [
          'uri' => $uri,
          'options' => $attributes ? ['attributes' => $attributes] : [],
        ],
        'menu_name' => $menu_name,
        'weight' => $weight,
        'expanded' => FALSE,
      ])->save();
    }
  }
}
