      ['Facebook', 'https://www.facebook.com/universitatrieste', $blank],
      ['LinkedIn', 'https://www.linkedin.com/school/universitadeglistudiditrieste/', $blank],
      ['YouTube', 'https://www.youtube.com/user/UniversitaTrieste', $blank],
      ['X', 'https://twitter.com/UniTrieste', $blank],
      ['Threads', 'https://www.threads.net/@unitrieste', $blank],
      ['TikTok', 'https://www.tiktok.com/@unitrieste', $blank],
      ['Rss', 'https://portale.units.it/it/feed'],
    ],
    'gc-contatti' => [
