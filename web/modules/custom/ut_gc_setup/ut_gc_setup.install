      ['Personale', 'https://www.units.it/personale'],
    ],
    'gc-servizio' => [
      ['Rubrica', 'https://www.units.it/search/abook/', ['class' => ['menu-servizi__mail']] + $blank],
      ['ACCEDI', 'https://portale.units.it/it/servizi/servizi-digitali', ['class' => ['accedi']]],
