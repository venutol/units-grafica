<?php

/**
 * @file
 * Popola i menu della grafica coordinata con i link attuali.
 *
 * Fonte: header e footer del JSON grafica-coordinata statico di onlineforms
 * (units117, ottobre 2026). Dopo l'installazione i link si gestiscono da
 * Struttura > Menu: questo file non viene più riletto.
 */

use Drupal\menu_link_content\Entity\MenuLinkContent;

